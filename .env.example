# ═══════════════════════════════════════════════════════════════════════════
#  FlowBoard – environment template
#  Copy this file to `.env` and fill in real secrets before running compose.
#     cp .env.example .env
#  NEVER commit `.env` to git (already covered by .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ─── MySQL ────────────────────────────────────────────────────────────────
# `root` is for admin only; services log in as the `flowboard` user.
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=flowboard
DB_PASSWORD=flowboard123

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── JWT (must be IDENTICAL across every service) ─────────────────────────
# Generate a strong one: `openssl rand -base64 48`
JWT_SECRET=mysecretkeymysecretkeymysecretkeymysecretkey
JWT_EXPIRATION=86400000

# ─── Google OAuth2 (auth-service) ─────────────────────────────────────────
# Get these from https://console.cloud.google.com → Credentials → OAuth 2.0
# Leave blank for local dev if you don't use Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Production overrides (leave blank for local dev) ─────────────────────
# Set these on the EC2 server's .env so OAuth + CORS use the public URLs.
# Local defaults (when blank) target localhost:4200 + localhost:8081.
# GOOGLE_REDIRECT_URI=http://<ec2-public-dns>:8081/login/oauth2/code/google
# OAUTH2_SUCCESS_REDIRECT=http://<frontend-url>/oauth2/redirect
# OAUTH2_FAILURE_REDIRECT=http://<frontend-url>/login
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://<frontend-url>
